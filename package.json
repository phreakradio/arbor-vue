{
  "name": "arbor-vue",
  "version": "1.1.1",
  "description": "Force-directed graph visualization for Vue 3",
  "license": "MIT",
  "type": "module",
  "main": "./dist/arbor-vue.js",
  "module": "./dist/arbor-vue.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/arbor-vue.js"
    },
    "./style.css": "./dist/arbor-vue.css"
  },
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phreakradio/arbor-vue.git"
  },
  "homepage": "https://github.com/phreakradio/arbor-vue#readme",
  "bugs": {
    "url": "https://github.com/phreakradio/arbor-vue/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "graph",
    "force-directed",
    "visualization"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.js",
    "lint": "eslint src --ext .js,.vue",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
